# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# OS
.DS_Store

# Secrets / environment (keep only the example template)
.env
.env.*
!.env.example
client_secrets.json
client_secret*.json
token.json

# State / generated output (regenerable, can be large)
queue/
produced/
outputs/
logs/*
!logs/.gitkeep

# Node / web builds
node_modules/
.next/
.vercel/
*.tsbuildinfo

# Python venv (heavy local video deps)
.venv-video/
venv/
.venv/

# Video models + build artifacts (heavy; regenerated by run_video)
engine/video/models/
engine/video/remotion/out/
engine/video/remotion/public/*.mp4
engine/video/remotion/public/*.wav
engine/video/remotion/public/*.mp3
engine/video/remotion/props.json
engine/video/renderer/renders/
# Throwaway SFX audition previews (regenerate via make_impact_sfx.sh)
engine/video/sfx_auditions/
engine/video/renderer/index.html
engine/video/renderer/*.mp4
engine/video/renderer/*.wav

# Pexels cross-video dedup ledger (state)
engine/video/used_clips.json

# music: keep curated mood folders + manifest; ignore unsorted/off-tone library
engine/video/music/_unused/
engine/music_all/
