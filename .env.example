# Copy to .env and fill in. .env is gitignored — never commit it.
# Reuse the SAME key ConvictionFinder uses (it lives in Railway, not on disk).
# Pull it without pasting it anywhere by hand:
#   railway link        # pick: ConvictionFinder → ConvictionFinder service
#   railway variables --kv | grep ANTHROPIC_API_KEY >> .env
# (or copy it from the Railway dashboard: ConvictionFinder → Variables)
ANTHROPIC_API_KEY=
