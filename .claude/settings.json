{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-/Users/bheemendergurram/untold_game_agents}/.claude/hooks/push-guard.sh\""
          },
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-/Users/bheemendergurram/untold_game_agents}/scripts/pr-review-gate.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "asyncRewake": true,
            "command": "bash \"${CLAUDE_PROJECT_DIR:-/Users/bheemendergurram/untold_game_agents}/.claude/hooks/engine-test.sh\""
          }
        ]
      }
    ]
  }
}
